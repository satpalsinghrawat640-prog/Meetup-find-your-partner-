# Copy this file to android-app/keystore.properties (NEVER commit real passwords or .jks files)
# Generate a release keystore once with:
#   keytool -genkey -v -keystore ig-meet-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias igmeet_release
storeFile=../ig-meet-release.jks
storePassword=REPLACE_WITH_KEYSTORE_PASSWORD
keyAlias=igmeet_release
keyPassword=REPLACE_WITH_KEY_PASSWORD
