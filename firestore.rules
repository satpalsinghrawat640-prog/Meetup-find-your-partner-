rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'owner' ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['owner', 'admin']
      );
    }

    function noPrivilegeEscalationOnCreate() {
      return request.resource.data.role == 'user'
        && request.resource.data.verified == false
        && request.resource.data.membershipTier == 'free'
        && request.resource.data.status == 'active'
        && request.resource.data.age is int
        && request.resource.data.age >= 18;
    }

    function noPrivilegeEscalationOnUpdate() {
      return request.resource.data.role == resource.data.role
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.membershipTier == resource.data.membershipTier
        && request.resource.data.membershipExpiresAt == resource.data.membershipExpiresAt
        && request.resource.data.status == resource.data.status
        && request.resource.data.age is int
        && request.resource.data.age >= 18;
    }

    // Users collection (private user settings + discovery profile)
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && noPrivilegeEscalationOnCreate();
      allow update: if isAdmin() || (isOwner(uid) && noPrivilegeEscalationOnUpdate());
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Public discovery mirror
    match /profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid)
        && request.resource.data.verified == false
        && request.resource.data.membershipTier == 'free'
        && request.resource.data.status == 'active'
        && request.resource.data.age >= 18;
      allow update: if isAdmin() || (
        isOwner(uid)
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.membershipTier == resource.data.membershipTier
        && request.resource.data.status == resource.data.status
        && request.resource.data.age >= 18
      );
      allow delete: if isAdmin() || isOwner(uid);
    }

    // Posts
    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Swipes (likes, passes, superLikes)
    match /likes/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.fromUid == request.auth.uid);
    }
    match /passes/{id} {
      allow read: if isSignedIn() && resource.data.fromUid == request.auth.uid;
      allow create, update: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.fromUid == request.auth.uid);
    }
    match /superLikes/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.fromUid == request.auth.uid);
    }

    // Matches
    match /matches/{matchId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.users);
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid in request.resource.data.users);
      allow delete: if isAdmin();
    }

    // Personal Chats & Messages
    match /personalChats/{chatId} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid in resource.data.users);
      allow create, update: if isAdmin() || (isSignedIn() && request.auth.uid in request.resource.data.users);
      allow delete: if isAdmin();
    }
    match /personalMessages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAdmin() || isSignedIn();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    // Global Chat
    match /globalChatMessages/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
      allow delete, update: if isAdmin() || (isSignedIn() && resource.data.senderId == request.auth.uid);
    }

    // Blocked Users
    match /blockedUsers/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.blockerUid == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && resource.data.blockerUid == request.auth.uid);
    }

    // Reports (private to reporter & admin)
    match /reports/{reportId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.reporterId == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Verification Requests (private selfies: applicant & admin only)
    match /verificationRequests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Membership Payment Requests (always created pending; only admin approves/rejects)
    match /paymentRequests/{reqId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // Support Tickets
    match /supportRequests/{ticketId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'Pending';
      allow update, delete: if isAdmin();
    }

    // Notifications
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn();
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // Admin-managed public-read configurations
    match /membershipPlans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /adminSettings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /swipePromotions/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /supportContacts/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /announcements/{annId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /coupons/{couponId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn()
        && request.resource.data.usedCount == resource.data.usedCount + 1
        && request.resource.data.code == resource.data.code
        && request.resource.data.discountPercent == resource.data.discountPercent
      );
    }

    // Admin-only collections
    match /subscriptions/{subId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /paymentHistory/{histId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow write: if isAdmin();
    }
    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }
    match /adminConfig/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
