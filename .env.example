# IG Meet Firebase Web Overrides (optional for web preview)
# Provide your actual Firebase Realtime Database URL from Firebase Console (do not invent a region URL)
VITE_FIREBASE_DATABASE_URL="https://ig-meet--find-your-partner-default-rtdb.firebaseio.com"

# Provide your Web App ID from Firebase Console -> Project Settings -> Your apps -> Web app
VITE_FIREBASE_WEB_APP_ID=""

# AI Studio standard variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
